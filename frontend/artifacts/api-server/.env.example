PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/proofpoint
# Base URL of the Python interview-engine backend (see backend/README.md).
BACKEND_URL=http://localhost:8000
# Secret used to sign the auth session cookie. Required in production; if unset
# in dev, a random secret is generated per process (existing sessions won't
# survive a restart).
SESSION_SECRET=change-me-to-a-long-random-string
# Where the local SQLite auth database lives. Defaults to ./data/auracheck.db
# relative to this package.
AUTH_DB_PATH=
