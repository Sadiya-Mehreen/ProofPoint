# Absolute URL of the api-server, only needed when it's deployed on a
# different origin than this build (e.g. this app on Vercel, api-server on
# Render). Read at build time -- baked into the static bundle by Vite.
# Leave unset for local dev, where the Vite dev server proxies /api to
# API_SERVER_URL (see vite.config.ts) on the same origin.
VITE_API_BASE_URL=
